iteline\"><value name=\"text\"><shadow type=\"text\"><field name=\"TEXT\">F: ZWOLNIONO</field></shadow></value></block></statement></block><block type=\"dfGamepad_onButton\" x=\"887\" y=\"1095\"><field name=\"button\">dfGamepad.GamepadButton.Z</field><field name=\"event\">dfGamepad.ButtonEvent.Pressed</field><data>6</data><statement name=\"HANDLER\"><block type=\"serial_writeline\"><value name=\"text\"><shadow type=\"text\"><field name=\"TEXT\">Z: NACISNIETO</field></shadow></value></block></statement></block><block type=\"dfGamepad_onButton\" x=\"1325\" y=\"1095\"><field name=\"button\">dfGamepad.GamepadButton.Z</field><field name=\"event\">dfGamepad.ButtonEvent.Held</field><statement name=\"HANDLER\"><block type=\"serial_writeline\"><value name=\"text\"><shadow type=\"text\"><field name=\"TEXT\">Z: PRZYTRZYMANO</field></shadow></value></block></statement></block><block type=\"dfGamepad_onButton\" x=\"1782\" y=\"1095\"><field name=\"button\">dfGamepad.GamepadButton.Z</field><field name=\"event\">dfGamepad.ButtonEvent.Released</field><statement name=\"HANDLER\"><block type=\"serial_writeline\"><value name=\"text\"><shadow type=\"text\"><field name=\"TEXT\">Z: ZWOLNIONO</field></shadow></value></block></statement></block></xml>","main.ts":"","README.md":"","gamepad.ts":"/**\n * DFRobot GamePad V4.0\n * MakeCode extension for micro:bit V2\n * Version 0.3\n */\n//% color=\"#00897B\" icon=\"\\uf11b\" block=\"DFRobot GamePad\"\nnamespace dfGamepad {\n\n    export enum ResponseMode {\n        //% block=\"linear\"\n        Linear = 0,\n        //% block=\"smooth\"\n        Smooth = 1,\n        //% block=\"dynamic\"\n        Dynamic = 2\n    }\n\n    export enum GamepadButton {\n        //% block=\"A\"\n        A = 0,\n        //% block=\"B\"\n        B = 1,\n        //% block=\"C\"\n        C = 2,\n        //% block=\"D\"\n        D = 3,\n        //% block=\"E\"\n        E = 4,\n        //% block=\"F\"\n        F = 5,\n        //% block=\"Z\"\n        Z = 6\n    }\n\n    export enum ButtonEvent {\n        //% block=\"pressed\"\n        Pressed = 0,\n        //% block=\"held\"\n        Held = 1,\n        //% block=\"released\"\n        Released = 2\n    }\n\n    // =====================================\n    // JOYSTICK\n    // =====================================\n\n    let centerX = 512\n    let centerY = 512\n\n    let deadZone = 10\n    let maxSpeed = 100\n\n    let invertX = false\n    let invertY = false\n\n    let responseMode = ResponseMode.Linear\n\n    let currentX = 0\n    let currentY = 0\n\n    let currentM1 = 0\n    let currentM2 = 0\n\n    let currentRawX = 512\n    let currentRawY = 512\n\n    /**\n     * Calibrate joystick center.\n     * Keep joystick released.\n     */\n    //% block=\"calibrate joystick\"\n    //% weight=100\n    export function calibrate(): void {\n\n        let sumX = 0\n        let sumY = 0\n\n        for (let i = 0; i < 20; i++) {\n            sumX += pins.analogReadPin(AnalogPin.P1)\n            sumY += pins.analogReadPin(AnalogPin.P2)\n            basic.pause(10)\n        }\n\n        centerX = Math.round(sumX / 20)\n        centerY = Math.round(sumY / 20)\n\n        update()\n    }\n\n    /**\n     * Set joystick dead zone.\n     */\n    //% block=\"set dead zone %value %%\"\n    //% value.min=0 value.max=30\n    //% weight=95\n    export function setDeadZone(value: number): void {\n        deadZone = Math.constrain(value, 0, 30)\n    }\n\n    /**\n     * Set maximum motor speed.\n     */\n    //% block=\"set maximum motor speed %speed %%\"\n    //% speed.min=0 speed.max=100\n    //% weight=94\n    export function setMaxSpeed(speed: number): void {\n        maxSpeed = Math.constrain(speed, 0, 100)\n    }\n\n    /**\n     * Set joystick response characteristic.\n     */\n    //% block=\"set joystick response %mode\"\n    //% weight=93\n    export function setResponse(mode: ResponseMode): void {\n        responseMode = mode\n    }\n\n    /**\n     * Invert X axis.\n     */\n    //% block=\"invert X %enabled\"\n    //% weight=92\n    export function invertXAxis(enabled: boolean): void {\n        invertX = enabled\n    }\n\n    /**\n     * Invert Y axis.\n     */\n    //% block=\"invert Y %enabled\"\n    //% weight=91\n    export function invertYAxis(enabled: boolean): void {\n        invertY = enabled\n    }\n\n    function convertAxis(value: number, center: number): number {\n\n        let result = 0\n\n        if (value >= center) {\n            result = (value - center) * 100 / (1023 - center)\n        } else {\n            result = (value - center) * 100 / center\n        }\n\n        result = Math.constrain(result, -100, 100)\n\n        if (Math.abs(result) <= deadZone) {\n            return 0\n        }\n\n        if (result > 0) {\n            result = (result - deadZone) * 100 / (100 - deadZone)\n        } else {\n            result = (result + deadZone) * 100 / (100 - deadZone)\n        }\n\n        return Math.constrain(result, -100, 100)\n    }\n\n    function applyResponse(value: number): number {\n\n        let sign = value < 0 ? -1 : 1\n        let magnitude = Math.abs(value) / 100\n\n        if (responseMode == ResponseMode.Smooth) {\n            magnitude = magnitude * magnitude\n        } else if (responseMode == ResponseMode.Dynamic) {\n            magnitude = Math.sqrt(magnitude)\n        }\n\n        return Math.round(sign * magnitude * 100)\n    }\n\n    /**\n     * Update joystick and motor calculations.\n     */\n    //% block=\"update joystick\"\n    //% weight=90\n    export function update(): void {\n\n        currentRawX = pins.analogReadPin(AnalogPin.P1)\n        currentRawY = pins.analogReadPin(AnalogPin.P2)\n\n        let x = convertAxis(currentRawX, centerX)\n        let y = convertAxis(currentRawY, centerY)\n\n        if (invertX) x = -x\n        if (invertY) y = -y\n\n        currentX = applyResponse(x)\n        currentY = applyResponse(y)\n\n        let m1 = currentY + currentX\n        let m2 = currentY - currentX\n\n        let maximum = Math.max(Math.abs(m1), Math.abs(m2))\n\n        if (maximum > 100) {\n            m1 = m1 * 100 / maximum\n            m2 = m2 * 100 / maximum\n        }\n\n        currentM1 = Math.round(m1 * maxSpeed / 100)\n        currentM2 = Math.round(m2 * maxSpeed / 100)\n    }\n\n    /**\n     * Last raw X reading.\n     */\n    //% block=\"joystick X raw\"\n    //% weight=85\n    export function rawX(): number {\n        return currentRawX\n    }\n\n    /**\n     * Last raw Y reading.\n     */\n    //% block=\"joystick Y raw\"\n    //% weight=84\n    export function rawY(): number {\n        return currentRawY\n    }\n\n    /**\n     * Last joystick X (-100 to 100).\n     */\n    //% block=\"joystick X %%\"\n    //% weight=83\n    export function joystickX(): number {\n        return currentX\n    }\n\n    /**\n     * Last joystick Y (-100 to 100).\n     */\n    //% block=\"joystick Y %%\"\n    //% weight=82\n    export function joystickY(): number {\n        return currentY\n    }\n\n    /**\n     * Left motor speed.\n     */\n    //% block=\"motor M1 speed\"\n    //% weight=81\n    export function motorM1(): number {\n        return currentM1\n    }\n\n    /**\n     * Right motor speed.\n     */\n    //% block=\"motor M2 speed\"\n    //% weight=80\n    export function motorM2(): number {\n        return currentM2\n    }\n\n    // =====================================\n    // BUTTONS\n    // =====================================\n\n    const BUTTON_EVENT_ID = 8900\n\n    let buttonsInitialized = false\n\n    let holdTime = 1000\n    let debounceTime = 30\n\n    let buttonPins: DigitalPin[] = [\n        DigitalPin.P5,\n        DigitalPin.P11,\n        DigitalPin.P13,\n        DigitalPin.P14,\n        DigitalPin.P15,\n        DigitalPin.P16,\n        DigitalPin.P8\n    ]\n\n    let stableState: boolean[] = [\n        false, false, false, false,\n        false, false, false\n    ]\n\n    let lastRawState: boolean[] = [\n        false, false, false, false,\n        false, false, false\n    ]\n\n    let changeTime: number[] = [\n        0, 0, 0, 0, 0, 0, 0\n    ]\n\n    let pressTime: number[] = [\n        0, 0, 0, 0, 0, 0, 0\n    ]\n\n    let holdReported: boolean[] = [\n        false, false, false, false,\n        false, false, false\n    ]\n\n    function eventValue(\n        button: GamepadButton,\n        event: ButtonEvent\n    ): number {\n        return button * 3 + event + 1\n    }\n\n    function readButton(index: number): boolean {\n        return pins.digitalReadPin(buttonPins[index]) == 0\n    }\n\n    /**\n     * Initialize gamepad buttons.\n     */\n    //% block=\"initialize buttons\"\n    //% weight=70\n    export function initButtons(): void {\n\n        if (buttonsInitialized) {\n            return\n        }\n\n        // P5 and P11 share connections with LED matrix\n        led.enable(false)\n\n        for (let i = 0; i < 7; i++) {\n            pins.setPull(buttonPins[i], PinPullMode.PullUp)\n\n            let state = readButton(i)\n\n            stableState[i] = state\n            lastRawState[i] = state\n\n            changeTime[i] = input.runningTime()\n            pressTime[i] = input.runningTime()\n\n            holdReported[i] = false\n        }\n\n        buttonsInitialized = true\n\n        control.inBackground(function () {\n\n            while (true) {\n\n                let now = input.runningTime()\n\n                for (let i = 0; i < 7; i++) {\n\n                    let raw = readButton(i)\n\n                    if (raw != lastRawState[i]) {\n                        lastRawState[i] = raw\n                        changeTime[i] = now\n                    }\n\n                    if (\n                        raw != stableState[i] &&\n                        now - changeTime[i] >= debounceTime\n                    ) {\n\n                        stableState[i] = raw\n\n                        if (raw) {\n\n                            pressTime[i] = now\n                            holdReported[i] = false\n\n                            control.raiseEvent(\n                                BUTTON_EVENT_ID,\n                                eventValue(i, ButtonEvent.Pressed)\n                            )\n\n                        } else {\n\n                            control.raiseEvent(\n                                BUTTON_EVENT_ID,\n                                eventValue(i, ButtonEvent.Released)\n                            )\n                        }\n                    }\n\n                    if (\n                        stableState[i] &&\n                        !holdReported[i] &&\n                        now - pressTime[i] >= holdTime\n                    ) {\n\n                        holdReported[i] = true\n\n                        control.raiseEvent(\n                            BUTTON_EVENT_ID,\n                            eventValue(i, ButtonEvent.Held)\n                        )\n                    }\n                }\n\n                basic.pause(10)\n            }\n        })\n    }\n\n    /**\n     * Check whether a gamepad button is pressed.\n     */\n    //% block=\"button %button is pressed\"\n    //% weight=65\n    export function isPressed(button: GamepadButton): boolean {\n\n        initButtons()\n\n        return stableState[button]\n    }\n\n    /**\n     * Set button hold time in milliseconds.\n     */\n    //% block=\"set button hold time %milliseconds ms\"\n    //% milliseconds.min=100 milliseconds.max=5000\n    //% weight=64\n    export function setHoldTime(milliseconds: number): void {\n\n        holdTime = Math.constrain(milliseconds, 100, 5000)\n    }\n\n    /**\n     * Set button debounce time in milliseconds.\n     */\n    //% block=\"set button debounce %milliseconds ms\"\n    //% milliseconds.min=0 milliseconds.max=100\n    //% weight=63\n    export function setDebounce(milliseconds: number): void {\n\n        debounceTime = Math.constrain(milliseconds, 0, 100)\n    }\n\n    /**\n     * Run code when a button is pressed, held or released.\n     */\n    //% block=\"on button %button %event\"\n    //% weight=60\n    export function onButton(\n        button: GamepadButton,\n        event: ButtonEvent,\n        handler: () => void\n    ): void {\n\n        initButtons()\n\n        control.onEvent(\n            BUTTON_EVENT_ID,\n            eventValue(button, event),\n            handler\n        )\n    }\n}","_locales/pl/gamepad-strings.json":"{\r\n    \"dfGamepad\": \"DFRobot GamePad\",\r\n    \"dfGamepad.calibrate|block\": \"kalibruj joystick\",\r\n    \"dfGamepad.setDeadZone|block\": \"ustaw martwą strefę %value %%\",\r\n    \"dfGamepad.setMaxSpeed|block\": \"ustaw maksymalną prędkość silników %speed %%\",\r\n    \"dfGamepad.setResponse|block\": \"ustaw charakterystykę joysticka %mode\",\r\n    \"dfGamepad.invertXAxis|block\": \"odwróć oś X %enabled\",\r\n    \"dfGamepad.invertYAxis|block\": \"odwróć oś Y %enabled\",\r\n    \"dfGamepad.update|block\": \"aktualizuj joystick\",\r\n    \"dfGamepad.rawX|block\": \"surowa wartość X\",\r\n    \"dfGamepad.rawY|block\": \"surowa wartość Y\",\r\n    \"dfGamepad.joystickX|block\": \"joystick X %%\",\r\n    \"dfGamepad.joystickY|block\": \"joystick Y %%\",\r\n    \"dfGamepad.motorM1|block\": \"prędkość silnika M1\",\r\n    \"dfGamepad.motorM2|block\": \"prędkość silnika M2\",\r\n    \"dfGamepad.initButtons|block\": \"inicjalizuj przyciski\",\r\n    \"dfGamepad.isPressed|block\": \"przycisk %button jest naciśnięty\",\r\n    \"dfGamepad.setHoldTime|block\": \"ustaw czas przytrzymania %milliseconds ms\",\r\n    \"dfGamepad.setDebounce|block\": \"ustaw eliminację drgań %milliseconds ms\",\r\n    \"dfGamepad.onButton|block\": \"po zdarzeniu przycisku %button %event\",\r\n    \"dfGamepad.ResponseMode.Linear|block\": \"liniowa\",\r\n    \"dfGamepad.ResponseMode.Smooth|block\": \"łagodna\",\r\n    \"dfGamepad.ResponseMode.Dynamic|block\": \"dynamiczna\",\r\n    \"dfGamepad.ButtonEvent.Pressed|block\": \"naciśnięto\",\r\n    \"dfGamepad.ButtonEvent.Held|block\": \"przytrzymano\",\r\n    \"dfGamepad.ButtonEvent.Released|block\": \"zwolniono\",\r\n    \"dfGamepad.GamepadButton.A|block\": \"A\",\r\n    \"dfGamepad.GamepadButton.B|block\": \"B\",\r\n    \"dfGamepad.GamepadButton.C|block\": \"C\",\r\n    \"dfGamepad.GamepadButton.D|block\": \"D\",\r\n    \"dfGamepad.GamepadButton.E|block\": \"E\",\r\n    \"dfGamepad.GamepadButton.F|block\": \"F\",\r\n    \"dfGamepad.GamepadButton.Z|block\": \"Z\"\r\n}","pxt.json":"{\n    \"name\": \"pxt-dfrobot-gamepad-v4\",\n    \"description\": \"\",\n    \"dependencies\": {\n        \"core\": \"*\",\n        \"radio\": \"*\",\n        \"microphone\": \"*\"\n    },\n    \"files\": [\n        \"main.blocks\",\n        \"main.ts\",\n        \"README.md\",\n        \"gamepad.ts\",\n        \"_locales/pl/gamepad-strings.json\"\n    ],\n    \"preferredEditor\": \"blocksprj\"\n}\n"}}],"shares":[],"lastSaveTime":1795350518865}