{"entries":[{"timestamp":1795348327730,"editorVersion":"9.0.12","changes":[{"type":"edited","filename":"main.blocks","patch":[{"start1":0,"length1":17785,"diffs":[[1,"<xml xmlns=\"http://www.w3.org/1999/xhtml\">\n  <block type=\"pxt-on-start\"></block>\n  <block type=\"device_forever\"></block>\n</xml>"]]}]},{"type":"edited","filename":"main.ts","patch":[{"start1":0,"length1":179,"diffs":[[1,""]]},{"start1":1,"length1":849,"diffs":[[1,""]]}]},{"type":"edited","filename":"pxt.json","patch":[{"start1":2,"length1":38,"diffs":[[1,"    \"name\": \"DFRobot GamePad V4 TEST\",\n"]]},{"start1":219,"length1":42,"diffs":[[1,"        \"README.md\"\n"]]},{"start1":246,"length1":31,"diffs":[[1,"    \"additionalFilePaths\": []\n"]]}]},{"type":"added","filename":"gamepad.ts","value":"/**\n * DFRobot GamePad V4.0\n * Analog joystick and differential motor control.\n * Version 0.2\n */\n//% color=\"#00897B\" icon=\"\\uf11b\" block=\"DFRobot GamePad\"\nnamespace dfGamepad {\n\n    export enum ResponseMode {\n        //% block=\"linear\"\n        Linear = 0,\n        //% block=\"smooth\"\n        Smooth = 1,\n        //% block=\"dynamic\"\n        Dynamic = 2\n    }\n\n    let centerX = 512\n    let centerY = 512\n\n    let deadZone = 10\n    let maxSpeed = 100\n\n    let invertX = false\n    let invertY = false\n\n    let responseMode = ResponseMode.Linear\n\n    let currentX = 0\n    let currentY = 0\n    let currentM1 = 0\n    let currentM2 = 0\n\n    let currentRawX = 512\n    let currentRawY = 512\n\n    /**\n     * Calibrate joystick center.\n     * Keep joystick released.\n     */\n    //% block=\"calibrate joystick\"\n    //% weight=100\n    export function calibrate(): void {\n\n        let sumX = 0\n        let sumY = 0\n\n        for (let i = 0; i < 20; i++) {\n            sumX += pins.analogReadPin(AnalogPin.P1)\n            sumY += pins.analogReadPin(AnalogPin.P2)\n            basic.pause(10)\n        }\n\n        centerX = Math.round(sumX / 20)\n        centerY = Math.round(sumY / 20)\n\n        update()\n    }\n\n    /**\n     * Set joystick dead zone (0-30%).\n     */\n    //% block=\"set dead zone %value %%\"\n    //% value.min=0 value.max=30\n    //% weight=90\n    export function setDeadZone(value: number): void {\n        deadZone = Math.constrain(value, 0, 30)\n    }\n\n    /**\n     * Set maximum motor speed (0-100%).\n     */\n    //% block=\"set maximum motor speed %speed %%\"\n    //% speed.min=0 speed.max=100\n    //% weight=89\n    export function setMaxSpeed(speed: number): void {\n        maxSpeed = Math.constrain(speed, 0, 100)\n    }\n\n    /**\n     * Set joystick response characteristic.\n     */\n    //% block=\"set joystick response %mode\"\n    //% weight=88\n    export function setResponse(mode: ResponseMode): void {\n        responseMode = mode\n    }\n\n    /**\n     * Invert X axis.\n     */\n    //% block=\"invert X %enabled\"\n    //% weight=87\n    export function invertXAxis(enabled: boolean): void {\n        invertX = enabled\n    }\n\n    /**\n     * Invert Y axis.\n     */\n    //% block=\"invert Y %enabled\"\n    //% weight=86\n    export function invertYAxis(enabled: boolean): void {\n        invertY = enabled\n    }\n\n    function convertAxis(value: number, center: number): number {\n\n        let result = 0\n\n        if (value >= center) {\n            result = (value - center) * 100 / (1023 - center)\n        } else {\n            result = (value - center) * 100 / center\n        }\n\n        result = Math.constrain(result, -100, 100)\n\n        if (Math.abs(result) <= deadZone) {\n            return 0\n        }\n\n        // Scale remaining range to 0-100%\n        if (result > 0) {\n            result = (result - deadZone) * 100 / (100 - deadZone)\n        } else {\n            result = (result + deadZone) * 100 / (100 - deadZone)\n        }\n\n        return Math.constrain(result, -100, 100)\n    }\n\n    function applyResponse(value: number): number {\n\n        let sign = value < 0 ? -1 : 1\n        let magnitude = Math.abs(value) / 100\n\n        if (responseMode == ResponseMode.Smooth) {\n            magnitude = magnitude * magnitude\n        } else if (responseMode == ResponseMode.Dynamic) {\n            magnitude = Math.sqrt(magnitude)\n        }\n\n        return Math.round(sign * magnitude * 100)\n    }\n\n    /**\n     * Update joystick and motor calculations.\n     * Call once before reading values.\n     */\n    //% block=\"update joystick\"\n    //% weight=95\n    export function update(): void {\n\n        currentRawX = pins.analogReadPin(AnalogPin.P1)\n        currentRawY = pins.analogReadPin(AnalogPin.P2)\n\n        let x = convertAxis(currentRawX, centerX)\n        let y = convertAxis(currentRawY, centerY)\n\n        if (invertX) x = -x\n        if (invertY) y = -y\n\n        currentX = applyResponse(x)\n        currentY = applyResponse(y)\n\n        // Differential drive\n        let m1 = currentY + currentX\n        let m2 = currentY - currentX\n\n        // Proportional normalization\n        let maximum = Math.max(Math.abs(m1), Math.abs(m2))\n\n        if (maximum > 100) {\n            m1 = m1 * 100 / maximum\n            m2 = m2 * 100 / maximum\n        }\n\n        currentM1 = Math.round(m1 * maxSpeed / 100)\n        currentM2 = Math.round(m2 * maxSpeed / 100)\n    }\n\n    /**\n     * Last raw X reading (0-1023).\n     */\n    //% block=\"joystick X raw\"\n    //% weight=80\n    export function rawX(): number {\n        return currentRawX\n    }\n\n    /**\n     * Last raw Y reading (0-1023).\n     */\n    //% block=\"joystick Y raw\"\n    //% weight=79\n    export function rawY(): number {\n        return currentRawY\n    }\n\n    /**\n     * Last joystick X (-100 to 100).\n     */\n    //% block=\"joystick X %%\"\n    //% weight=78\n    export function joystickX(): number {\n        return currentX\n    }\n\n    /**\n     * Last joystick Y (-100 to 100).\n     */\n    //% block=\"joystick Y %%\"\n    //% weight=77\n    export function joystickY(): number {\n        return currentY\n    }\n\n    /**\n     * Left motor speed (-100 to 100).\n     */\n    //% block=\"motor M1 speed\"\n    //% weight=70\n    export function motorM1(): number {\n        return currentM1\n    }\n\n    /**\n     * Right motor speed (-100 to 100).\n     */\n    //% block=\"motor M2 speed\"\n    //% weight=69\n    export function motorM2(): number {\n        return currentM2\n    }\n}"}]},{"timestamp":1795348913740,"editorVersion":"9.0.12","changes":[{"type":"edited","filename":"main.blocks","patch":[{"start1":0,"length1":349,"diffs":[[1,"<xml xmlns=\"https://developers.google.com/blockly/xml\"><variables><variable id=\"8^8b.1UgqXgne#s`rh]G\">result</variable><variable id=\"GYcrmO$;%WJ874^k^yv6\">deadZone</variable><variable id=\"#z]uwR^i`gcGp.|U`$g4\">x</variable><variable id=\"UTvD8B@e-o02C87n6EfK\">y</variable><variable id=\"?Q)E;c4:bcX{vilti0}4\">xPercent</variable><variable id=\":iZx45g=8zZ^U*8yzm#l\">centerX</variable><variable id=\"`~(`1U2eP%bG|p8Azfko\">yPercent</variable><variable id=\"$NBPO}kq3oP,6yTe?Hbz\">centerY</variable><variable id=\"yE{%.9Gq6m9K`?t[:rJt\">sumX</variable><variable id=\"/95fEed*d(Ax8qp/fq6k\">sumY</variable></variables><comment x=\"2430.53125\" y=\"20\" w=\"370\" h=\"120\">\n-------------------------------------\nPrzeliczanie ADC na -100 ... +100\n-------------------------------------\n</comment><comment x=\"20\" y=\"1393\" w=\"370\" h=\"120\">\n-------------------------------------\nOdczyt joysticka\n-------------------------------------\n</comment><comment x=\"435\" y=\"1393\" w=\"370\" h=\"120\">\n-------------------------------------\nKalibracja srodka\n-------------------------------------\n</comment><comment x=\"850\" y=\"1393\" w=\"370\" h=\"120\">\n-------------------------------------\nStart\n-------------------------------------\n</comment><comment x=\"1265\" y=\"1393\" w=\"370\" h=\"200\">\n=====================================\n"]]},{"start1":1300,"length1":49,"diffs":[